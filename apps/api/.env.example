# ---------------------------------------------------------------------------
# MiniLedger API - local development configuration
# Copy to `.env` and adjust. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection string (matches the docker-compose service).
DATABASE_URL=postgres://miniledger:miniledger_dev_password@localhost:5432/miniledger
# Dedicated database used by the integration test suite.
DATABASE_URL_TEST=postgres://miniledger:miniledger_dev_password@localhost:5432/miniledger_test

# Sign the JWT access tokens. Use a long random value in any real environment.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=604800

# Mock OTP behaviour.
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# Set to false to stop printing the mock OTP to the API terminal.
OTP_LOG_ENABLED=true

# Rate limiting (per window) for the OTP endpoints.
OTP_RATE_LIMIT_PER_PHONE=5
OTP_RATE_LIMIT_PER_IP=30
OTP_RATE_LIMIT_WINDOW_MS=600000

# Calendar timezone used to decide whether a loan is overdue.
APP_TIMEZONE=Asia/Kolkata

# Comma separated list of allowed origins, or * for any origin (development).
CORS_ORIGINS=*

# Where uploaded receipt images are stored (relative to apps/api).
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# debug | info | warn | error | silent
LOG_LEVEL=info
